# Client – Development Dockerfile (Vite hot-reload)
FROM node:20-alpine
WORKDIR /app

# Install deps first (better layer caching)
COPY package*.json ./
RUN npm install

# Source code is bind-mounted at runtime (see docker-compose.yml)
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
