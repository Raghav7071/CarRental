// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String    @unique
  password  String
  role      String    @default("user") // "owner" or "user"
  image     String?   @default("")
  cars      Car[]     @relation("UserCars")
  bookings  Booking[] @relation("UserBookings")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Car {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  owner            User      @relation("UserCars", fields: [ownerId], references: [id])
  ownerId          String    @db.ObjectId
  brand            String
  model            String
  image            String
  year             Int
  category         String
  seating_capacity Int
  fuel_type        String
  transmission     String
  pricePerDay      String
  location         String    @default("Available")
  description      String?   @default("")
  isAvailable      Boolean   @default(true)
  bookings         Booking[] @relation("CarBookings")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Booking {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User     @relation("UserBookings", fields: [userId], references: [id])
  userId     String   @db.ObjectId
  car        Car      @relation("CarBookings", fields: [carId], references: [id])
  carId      String   @db.ObjectId
  pickupDate String
  returnDate String
  amount     Int
  status     String   @default("pending") // "pending", "confirmed", "cancelled"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
